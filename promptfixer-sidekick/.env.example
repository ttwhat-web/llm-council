# Ollama runtime endpoint. Override if your daemon binds elsewhere.
OLLAMA_HOST=http://127.0.0.1:11434

# Default supervisor model. Pulled with `ollama pull gemma2:2b` (alias for gemma4:e4b family).
OLLAMA_MODEL=gemma2:2b

# Fallback chain, comma separated. First reachable model wins.
OLLAMA_FALLBACKS=llama3:8b,mistral:7b

# Hard timeout for the supervisor pass (ms).
OLLAMA_TIMEOUT_MS=12000
