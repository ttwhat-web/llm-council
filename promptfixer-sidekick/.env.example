# =============================================================================
# AI ENGINE
# =============================================================================
# Default routing strategy. One of: auto | cloud | ollama | deterministic
#
#   auto           cloud (if key set) → ollama (if configured) → deterministic
#   cloud          force cloud; falls back to deterministic only
#   ollama         force ollama; strict — falls back to deterministic only
#   deterministic  never call out; rules engine only
AI_ENGINE=auto

# =============================================================================
# CLOUD PROVIDERS  (server-side only — NEVER ship these to the browser)
# =============================================================================
# Set at least one to enable Cloud AI. Anthropic is preferred when both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Defaults are tier-aware:
#   Anthropic free → claude-haiku-4-5-20251001     pro → claude-sonnet-4-6
#   OpenAI    free → gpt-4o-mini                   pro → gpt-4o
# CLOUD_MODEL_FREE=
# CLOUD_MODEL_PRO=
# CLOUD_TIMEOUT_MS=20000

# =============================================================================
# LOCAL OLLAMA (OPT-IN — for Mac power users / dev shells)
# =============================================================================
# Leave BLANK in the VPS environment. The server is NOT meant to host heavy
# local models. Set this only on machines that actually run `ollama serve`
# (your Mac, the bundled Tauri desktop app, or a dedicated GPU box).
OLLAMA_BASE_URL=

# ---- Local model profiles --------------------------------------------------
# Each profile maps to a quality level. The router picks the right profile
# based on the user's quality selection (and never silently falls through to
# cloud unless allowCloudFallback is explicitly enabled).
#
#   Fast fallback        gemma2:2b           low-resource baseline
#   Smart supervisor     gemma4              the daily driver
#   Coder/Terminal/AS400 qwen2.5-coder:7b    used by quality=code
#   Agent experiments    hermes3             reserved for agent mode
OLLAMA_FAST_MODEL=gemma2:2b
OLLAMA_SMART_MODEL=gemma4
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_AGENT_MODEL=hermes3

# Comma-separated chain tried after the per-quality profile, before the
# router falls through to deterministic. Useful when you've only pulled
# one or two of the profile models above.
# OLLAMA_FALLBACKS=gemma4,qwen2.5-coder:7b,gemma2:2b

# OLLAMA_TIMEOUT_MS=12000
# OLLAMA_ALLOW_REMOTE=0   # set 1 to allow non-localhost ollama in production

# =============================================================================
# USAGE LIMITS (daily, per-IP, in-process — replace with Redis/KV in prod)
# =============================================================================
FREE_DAILY_LIMIT=10
PRO_DAILY_LIMIT=1000

# =============================================================================
# MISSION ALERTS (Pro feature — Telegram BotFather notifications)
# =============================================================================
# Server-side only. The bot token NEVER reaches the browser.
TELEGRAM_BOT_TOKEN=

# Admin fallback chat id. Optional but strongly recommended — receives
# *hard* failures (safety blocked, system errors) when the user is not
# linked. Find via: send a message to your bot, then
# `curl https://api.telegram.org/bot<TOKEN>/getUpdates`.
TELEGRAM_ADMIN_CHAT_ID=

# Bot @username (without the @). Required for per-user linking — the UI
# uses it to build the deep link `https://t.me/<username>?start=PF-XXXXX`.
TELEGRAM_BOT_USERNAME=

# Webhook secret. Generate with `openssl rand -hex 32`. Pass the same
# value to Telegram via `setWebhook?secret_token=…` — Telegram echoes it
# in the X-Telegram-Bot-Api-Secret-Token header on every update. When
# unset, the webhook accepts any caller (DEV ONLY).
TELEGRAM_WEBHOOK_SECRET=

# Where the user→chat link table is persisted. JSON file, atomic writes.
# Defaults to `<cwd>/.data/telegram-links.json`. On serverless deploys
# (Vercel, Netlify) the fs is ephemeral — swap for Redis/Postgres in
# lib/telegram-links.ts.
# TELEGRAM_LINKS_FILE=.data/telegram-links.json

# Master client-visible feature flag. When "true", the UI shows the
# Mission Alerts panel in the Input column. When "false" (the default),
# the panel renders as a locked Pro pill. The actual sending is gated
# independently on the bot token above.
NEXT_PUBLIC_MISSION_ALERTS_ENABLED=false

# Optional. Per-IP rate limit for outgoing alerts. Defaults if omitted.
# MISSION_ALERTS_RATE_PER_MIN=5
