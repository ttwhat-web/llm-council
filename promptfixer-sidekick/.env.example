# =============================================================================
# AI ENGINE
# =============================================================================
# Default routing strategy. One of: auto | cloud | ollama | deterministic
#
#   auto           cloud (if key set) → ollama (if configured) → deterministic
#   cloud          force cloud; falls back to deterministic only
#   ollama         force ollama; strict — falls back to deterministic only
#   deterministic  never call out; rules engine only
AI_ENGINE=auto

# =============================================================================
# CLOUD PROVIDERS  (server-side only — NEVER ship these to the browser)
# =============================================================================
# Set at least one to enable Cloud AI. Anthropic is preferred when both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Defaults are tier-aware:
#   Anthropic free → claude-haiku-4-5-20251001     pro → claude-sonnet-4-6
#   OpenAI    free → gpt-4o-mini                   pro → gpt-4o
# CLOUD_MODEL_FREE=
# CLOUD_MODEL_PRO=
# CLOUD_TIMEOUT_MS=20000

# =============================================================================
# LOCAL OLLAMA (OPT-IN — for Mac power users / dev shells)
# =============================================================================
# Leave BLANK in the VPS environment. The server is NOT meant to host heavy
# local models. Set this only on machines that actually run `ollama serve`
# (your Mac, the bundled Tauri desktop app, or a dedicated GPU box).
OLLAMA_BASE_URL=

# ---- Local model profiles --------------------------------------------------
# Each profile maps to a quality level. The router picks the right profile
# based on the user's quality selection (and never silently falls through to
# cloud unless allowCloudFallback is explicitly enabled).
#
#   Fast fallback        gemma2:2b           low-resource baseline
#   Smart supervisor     gemma4              the daily driver
#   Coder/Terminal/AS400 qwen2.5-coder:7b    used by quality=code
#   Agent experiments    hermes3             reserved for agent mode
OLLAMA_FAST_MODEL=gemma2:2b
OLLAMA_SMART_MODEL=gemma4
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_AGENT_MODEL=hermes3

# Comma-separated chain tried after the per-quality profile, before the
# router falls through to deterministic. Useful when you've only pulled
# one or two of the profile models above.
# OLLAMA_FALLBACKS=gemma4,qwen2.5-coder:7b,gemma2:2b

# OLLAMA_TIMEOUT_MS=12000
# OLLAMA_ALLOW_REMOTE=0   # set 1 to allow non-localhost ollama in production

# =============================================================================
# USAGE LIMITS (daily, per-IP, in-process — replace with Redis/KV in prod)
# =============================================================================
FREE_DAILY_LIMIT=10
PRO_DAILY_LIMIT=1000

# =============================================================================
# BILLING  (Phase 4 — server-side gate; STUB by default, no payments yet)
# =============================================================================
# Provider switch. One of: stub | stripe | paddle.
#   stub    — no payments. /api/billing/checkout signs a dev-override cookie
#             when BILLING_DEV_OVERRIDE_SECRET is set. This is the default.
#   stripe  — placeholder. The route currently 503s; flip once
#             stripe.checkout.sessions.create() is wired.
#   paddle  — same as stripe. Reserved.
BILLING_PROVIDER=stub

# Public mirror of BILLING_PROVIDER for the UI's "Server verified" badge.
# Keep in sync with BILLING_PROVIDER above.
NEXT_PUBLIC_BILLING_MODE=stub

# Daily cloud-fix quota for the Free plan (server-enforced, replaces the
# legacy lib/usage.ts FREE_DAILY_LIMIT for billing decisions).
BILLING_FREE_DAILY_LIMIT=10

# HMAC secret used to sign the dev override cookie issued by
# /api/billing/checkout when Stripe isn't configured. When this is unset
# AND no Stripe keys are present, the checkout endpoint refuses Pro
# upgrades (the local-only Pro Preview fallback in the modal still works).
# Generate with `openssl rand -hex 32`.
BILLING_DEV_OVERRIDE_SECRET=

# Generic HMAC fallback for the webhook in stub mode. Used when neither
# Stripe nor a real provider is wired but you still want signed test
# replays. Stripe in real mode uses STRIPE_WEBHOOK_SECRET below instead.
BILLING_WEBHOOK_SECRET=

# Public URL of the deployed app — used to build Stripe success_url /
# cancel_url and the Customer Portal return_url. Required when Stripe
# is enabled. Defaults to http://localhost:3030 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3030

# =============================================================================
# AUTH (Clerk)  — Phase 6
# =============================================================================
# When unset, Mission Control still works fully — anonymous visitors get
# a session cookie and the free quota. Set both to enable Sign in / Sign
# up buttons + persistent identity across browsers.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# =============================================================================
# STRIPE  — Phase 6
# =============================================================================
# Server-side only. When STRIPE_SECRET_KEY is set:
#   - /api/billing/checkout  → real Stripe Checkout sessions
#   - /api/billing/portal    → real Stripe Customer Portal
#   - /api/billing/webhook   → verifies via stripe.webhooks.constructEvent
# When unset, /api/billing/* falls back to the dev-override stub above.
STRIPE_SECRET_KEY=

# Webhook signing secret from the Stripe dashboard. Required when
# STRIPE_SECRET_KEY is set; the webhook returns 401 on missing /
# mismatched signatures.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (one per SKU). Create these once in the Stripe
# dashboard, then paste the price_… ids here. The checkout route
# refuses to charge for plans whose price id isn't configured.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_FOUNDER_LIFETIME=

# =============================================================================
# MULTI-PAYMENT PROVIDERS  — Phase 8 (Stripe + Paddle + Lemon Squeezy +
# Crypto + Local manual). See PAYMENTS.md.
# =============================================================================
# Default provider when callers don't pick one. One of:
#   stripe | paddle | lemon_squeezy | crypto_manual | local_manual | stub
PAYMENT_PROVIDER=stub

# Backend for manual / crypto payment records (the queue admin reviews).
# Mirrors BILLING_STORE / MISSION_STORE precedence: dev → file,
# production → upstash if configured else memory.
PAYMENT_STORE=
PAYMENT_STORE_FILE=.promptfixer/payments.json

# Founder lifetime is capped (default 100). Once `claimed` reaches the
# cap the founder CTA disables itself across the UI AND every server
# checkout path rejects the founder plan with `code: "founder_sold_out"`.
FOUNDER_LIFETIME_CAP=100

# ---- Paddle (merchant-of-record) ------------------------------------------
# Paddle handles VAT / sales tax globally and ships in many regions
# Stripe doesn't. Stub until the SDK is wired (TODO in
# lib/payments/providers/paddle.ts).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_TEAM_ANNUAL=

# ---- Lemon Squeezy (merchant-of-record) -----------------------------------
# Turkey-friendly default. Native lifetime SKU support.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY=
LEMON_SQUEEZY_VARIANT_PRO_ANNUAL=
LEMON_SQUEEZY_VARIANT_TEAM_MONTHLY=
LEMON_SQUEEZY_VARIANT_TEAM_ANNUAL=
LEMON_SQUEEZY_VARIANT_FOUNDER_LIFETIME=

# =============================================================================
# TRANSACTIONAL EMAIL  — Phase 9 (Resend by default; no-op when unset)
# =============================================================================
# When RESEND_API_KEY + EMAIL_FROM are both set, the email adapter
# (lib/email/) sends transactional mail on:
#   - crypto payment submitted
#   - admin verified payment       (activation email)
#   - admin rejected payment       (rejection email)
#   - lemon order_created / subscription_created (activation)
#   - lemon subscription_payment_failed (payment-failed email)
# When unset, every send is a no-op + dev console trace.
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# ---- Crypto (manual, public addresses only) -------------------------------
# Master flag for crypto payments. When false, the provider reports
# disabled regardless of addresses below.
ENABLE_CRYPTO_PAYMENTS=false

# Public receiving addresses ONLY. Never private keys. Each network
# carries a strict-network warning the UI surfaces next to the address.
CRYPTO_BTC_ADDRESS=
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_USDT_ERC20_ADDRESS=
CRYPTO_USDC_ERC20_ADDRESS=
CRYPTO_SOL_ADDRESS=

# ---- Local manual (Turkey-first; reserved seat) ---------------------------
# Architecture seat for Shopier / iyzico / PayTR / wire transfer.
# Currently surfaces as a manual bank-transfer flow when enabled.
ENABLE_LOCAL_MANUAL_PAYMENTS=false
LOCAL_BANK_INSTRUCTIONS=
LOCAL_BANK_REFERENCE=operator.center

# ---- Admin (verifies manual / crypto payments) ----------------------------
# Production gate. Dev (NODE_ENV != production) always allows /admin/*.
# In production both flags must be set: ENABLE_ADMIN_ROUTES=true AND
# at least one email in ADMIN_EMAILS matching the Clerk identity.
ENABLE_ADMIN_ROUTES=false
ADMIN_EMAILS=

# =============================================================================
# LAUNCH MODE  — Phase 10
# =============================================================================
# Controls visible UI state across marketing + Mission Control.
#   dev           default. Internal warnings visible. No badges.
#   private_beta  amber "Private beta" badge on nav + Mission Control.
#                 Internal warnings still visible.
#   public        Clean public conversion UI. Warnings hidden from
#                 non-admin viewers; /launch still reports them.
# /api/health/full classifies every env check by severity AND by mode,
# so warnings become blockers when this flips to "public".
NEXT_PUBLIC_LAUNCH_MODE=dev

# Master switch for the founder lifetime SKU. When "false" the founder
# CTA is hidden everywhere and every checkout path refuses the plan
# (HTTP 410 founder_launch_disabled).
FOUNDER_LAUNCH_ENABLED=false

# =============================================================================
# LEGAL  — Phase 10
# =============================================================================
# Flip to "true" once counsel reviews the corresponding page. The
# launch checklist marks both as BLOCKERS in public-launch mode.
# Pages still render either way; a draft-banner appears on top until
# the flag is "true".
LEGAL_PRIVACY_REVIEWED=false
LEGAL_TERMS_REVIEWED=false

# =============================================================================
# UPSTASH REDIS  — Phase 6 (durable BillingStore in production)
# =============================================================================
# Upstash REST API endpoint + token. When both are set AND
# NODE_ENV=production (or BILLING_STORE=upstash), the BillingStore
# routes through Redis instead of the file-backed dev store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional dev hook. When "true" AND NODE_ENV !== "production", the
# auth seam in lib/auth/identity.ts honours an `x-user-email` header
# as the caller identity. Production NEVER trusts this even if the env
# is set. Pair with a real auth provider (Clerk / Auth.js / JWT) in
# lib/auth/identity.ts before launch.
ALLOW_DEV_USER_HEADER=false

# Durable billing store backend. One of:
#   memory  — in-process Map. Resets on deploy. Tests + last-resort fallback.
#   file    — JSON file at BILLING_STORE_FILE. Default in dev.
#   upstash — Upstash Redis via REST. Default in production when
#             UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN are set.
# When unset: dev → file; prod → upstash if configured else memory.
BILLING_STORE=

# Path of the file-backed store when BILLING_STORE=file. Resolves
# relative to process.cwd() if not absolute. Git-ignored — treat as
# ephemeral. Holds customers, subscriptions, usage and audit events.
BILLING_STORE_FILE=.promptfixer/billing-store.json

# =============================================================================
# MISSION RECEIPTS  — Phase 7 (durable mission archive + share permalinks)
# =============================================================================
# Selects the MissionStore backend. Same shape as BILLING_STORE:
#   memory  — in-process Map. Resets on deploy.
#   file    — JSON file at MISSION_STORE_FILE. Default in dev.
#   upstash — Upstash Redis via REST. Default in production when
#             UPSTASH_REDIS_REST_URL + TOKEN are set.
# When unset: dev → file; prod → upstash if configured else memory.
MISSION_STORE=

# Path of the file-backed mission store when MISSION_STORE=file.
# Git-ignored. Holds saved Mission Receipts.
MISSION_STORE_FILE=.promptfixer/missions.json

# =============================================================================
# ANALYTICS  — Phase 7 (lightweight, optional)
# =============================================================================
# When NEXT_PUBLIC_POSTHOG_KEY is set, the analytics adapter
# (lib/analytics.ts) lazy-loads posthog-js and ships events:
#   mission_run, mission_saved, mission_shared, stack_saved,
#   workflow_recorded, upgrade_modal_opened, checkout_started,
#   checkout_success.
# When unset, every track() call is a dev-console no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# MISSION ALERTS (Pro feature — Telegram BotFather notifications)
# =============================================================================
# Server-side only. The bot token NEVER reaches the browser.
TELEGRAM_BOT_TOKEN=

# Admin fallback chat id. Optional but strongly recommended — receives
# *hard* failures (safety blocked, system errors) when the user is not
# linked. Find via: send a message to your bot, then
# `curl https://api.telegram.org/bot<TOKEN>/getUpdates`.
TELEGRAM_ADMIN_CHAT_ID=

# Bot @username (without the @). Required for per-user linking — the UI
# uses it to build the deep link `https://t.me/<username>?start=PF-XXXXX`.
TELEGRAM_BOT_USERNAME=

# Webhook secret. Generate with `openssl rand -hex 32`. Pass the same
# value to Telegram via `setWebhook?secret_token=…` — Telegram echoes it
# in the X-Telegram-Bot-Api-Secret-Token header on every update. When
# unset, the webhook accepts any caller (DEV ONLY).
TELEGRAM_WEBHOOK_SECRET=

# Where the user→chat link table is persisted. JSON file, atomic writes.
# Defaults to `<cwd>/.data/telegram-links.json`. On serverless deploys
# (Vercel, Netlify) the fs is ephemeral — swap for Redis/Postgres in
# lib/telegram-links.ts.
# TELEGRAM_LINKS_FILE=.data/telegram-links.json

# Master client-visible feature flag. When "true", the UI shows the
# Mission Alerts panel in the Input column. When "false" (the default),
# the panel renders as a locked Pro pill. The actual sending is gated
# independently on the bot token above.
NEXT_PUBLIC_MISSION_ALERTS_ENABLED=false

# Optional. Per-IP rate limit for outgoing alerts. Defaults if omitted.
# MISSION_ALERTS_RATE_PER_MIN=5
